CLERK_SECRET_KEY=sk_test_cZI9RwUcgLMfd6HPsQgX898hSthNjnNGKRcaVGvUCK

# Backend Configuration
NEXT_PUBLIC_ZENAO_BACKEND_ENDPOINT=http://localhost:4242
NEXT_PUBLIC_ZENAO_NAMESPACE=zenao

# Stripe configuration
ZENAO_STRIPE_SECRET_KEY=sk_test_...
NEXT_PUBLIC_STRIPE_DASHBOARD_URL=https://dashboard.stripe.com/test

# Paid events feature flag (set to "true" to enable paid event creation and ticket purchases)
ZENAO_PAID_EVENTS_ENABLED=false

# File uploads - See README "File Uploads (IPFS)" section
# Local kubo gateway from dev.docker-compose.yml (use 127.0.0.1, not localhost)
NEXT_PUBLIC_IPFS_GATEWAY_URL=http://127.0.0.1:8080

# Observability (optional)
OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4318
SEOBOT_API_KEY=a8c58738-7b98-4597-b20a-0bb1c2fe5772

# Sentry error monitoring (optional — leave DSN empty to disable)
NEXT_PUBLIC_SENTRY_DSN=
NEXT_PUBLIC_ENV=development

# App URL for backend
ZENAO_APP_BASE_URL=http://localhost:3000/
